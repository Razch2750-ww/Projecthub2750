rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Memastikan user bisa mengakses setelah auth
    match /projects/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /tasks/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
