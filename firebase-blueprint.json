{
  "collections": {
    "projects": {
      "description": "Stores all projects",
      "fields": {
        "userId": "string (the uid of the owner)",
        "ptName": "string",
        "address": "string",
        "entryDate": "string",
        "createdAt": "string",
        "rooms": "array",
        "locations": "array",
        "roomTypes": "array",
        "panelThickness": "string",
        "panelType": "string",
        "floorType": "string",
        "outdoorMachine": "string",
        "evaporator": "string"
      }
    },
    "tasks": {
      "description": "Stores all tasks for projects",
      "fields": {
        "userId": "string (the uid of the owner)",
        "projectId": "string",
        "title": "string",
        "status": "string",
        "history": "array",
        "isAdditional": "boolean",
        "createdAt": "string"
      }
    },
    "calendar_events": {
      "description": "Stores all meeting and survey events",
      "fields": {
        "id": "string",
        "title": "string",
        "type": "string",
        "date": "string",
        "time": "string",
        "location": "string",
        "notes": "string",
        "isRecurring": "boolean",
        "recurrence": "object",
        "gcalEventId": "string",
        "createdAt": "string"
      }
    },
    "users": {
      "description": "Stores user profiles, roles, and real-time availability status",
      "fields": {
        "email": "string",
        "name": "string",
        "role": "string (admin | drafter | reviewer | guest)",
        "availability": "string (Available | Busy | On Leave)",
        "createdAt": "string"
      }
    },
    "role_permissions": {
      "description": "Stores granular page access configuration per role",
      "fields": {
        "dashboard": "boolean",
        "projects": "boolean",
        "calendar": "boolean",
        "calculator": "boolean",
        "heatload": "boolean",
        "settings": "boolean"
      }
    }
  }
}
